# ============================================================
# 水泳部 会計管理システム 環境変数のひな形
#   1. このファイルをコピーして .env.local という名前で保存する
#   2. = の右側に値を貼り付ける
#   3. .env.local は .gitignore で除外済み。絶対にコミットしないこと
# ============================================================

# --- Supabase（Project Settings → API） ---
# NEXT_PUBLIC_ が付くものはブラウザにも渡ります（URL と anon キーは公開されても問題ありません。
# データは RLS で守られています）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ★秘密：全権限キー。NEXT_PUBLIC_ を絶対に付けないこと（SS出力と夜間処理でのみ使用）
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets（第3段階で使用） ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 改行は \n のまま1行で貼ってください（例: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"）
GOOGLE_PRIVATE_KEY=
SPREADSHEET_ID=

# --- Vercel Cron（第6段階で使用）。長いランダム文字列を設定 ---
CRON_SECRET=
