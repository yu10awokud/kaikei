# ------------------------------------------------------------
# このファイルをコピーして .env.local を作ってください。
#   cp .env.local.example .env.local
# .env.local は .gitignore 済みなので Git には入りません。
# ------------------------------------------------------------

# Supabase のプロジェクト URL
# Supabase ダッシュボード > Project Settings > Data API > Project URL
# NEXT_PUBLIC_ が付いた変数はブラウザ側にも埋め込まれます（＝公開されます）。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase の anon (public) キー
# Project Settings > API Keys > anon public
# これは「公開してよい前提」のキーです。守るのは RLS ポリシーと、このアプリの合言葉です。
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 編集モードの合言葉
# NEXT_PUBLIC_ を付けていないので、サーバー側でしか読めません＝ブラウザに漏れません。
# 部内で共有する適当な文字列でOKです。
EDIT_PASSPHRASE=suiei2026
