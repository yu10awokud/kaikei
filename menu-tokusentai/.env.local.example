# ============================================================
# 環境変数のひな形（このファイルは Git にコミットされます）
#
# 使い方：
#   1. このファイルをコピーして .env.local という名前で保存する
#   2. 下の = の右側に Supabase の値を貼り付ける
#   3. .env.local は .gitignore で除外済み。絶対にコミットしないこと
#
# 値の場所：Supabase ダッシュボード → Project Settings → API
# ============================================================

# Project URL（例: https://xxxxxxxx.supabase.co）
# NEXT_PUBLIC_ が付くものはブラウザにも渡ります。URL は公開されても問題ありません。
NEXT_PUBLIC_SUPABASE_URL=

# anon public key（読み取り専用として使う公開キー。公開されても可）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（★最重要：全権限を持つ秘密キー）
# ・NEXT_PUBLIC_ を絶対に付けないこと
# ・サーバー側（app/api/...）でのみ使用し、ブラウザには渡しません
SUPABASE_SERVICE_ROLE_KEY=
